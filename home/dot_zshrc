# Environment
typeset -gU path fpath
path=("$HOME/.local/bin" $path)

for brew_prefix in /opt/homebrew /usr/local; do
  if [[ -d "$brew_prefix/share/zsh/site-functions" ]]; then
    fpath=("$brew_prefix/share/zsh/site-functions" $fpath)
    break
  fi
done
unset brew_prefix

# Keep a large command history across terminal windows. HISTFILE is declared
# here rather than left to /etc/zshrc, which this repository does not own.
HISTFILE="${ZDOTDIR:-$HOME}/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000

# SHARE_HISTORY already appends each command as it is typed and imports the
# ones other shells write. zshoptions calls it, APPEND_HISTORY and
# INC_APPEND_HISTORY mutually exclusive, so it stands alone.
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS

# Plugins
autoload -Uz colors && colors
zstyle ':plugin:ez-compinit' use-cache on

# An arrow key reaches zle as the normal-mode sequence unless something has put
# the terminal in application mode by sending smkx; nothing here does. So the
# normal-mode sequences are bound outright and terminfo's are added on top —
# binding terminfo alone leaves the search unreachable.
bind_history_substring_search() {
  local -a up=($'\e[A') down=($'\e[B')

  if zmodload zsh/terminfo 2>/dev/null; then
    [[ -n "${terminfo[kcuu1]:-}" ]] && up+=("$terminfo[kcuu1]")
    [[ -n "${terminfo[kcud1]:-}" ]] && down+=("$terminfo[kcud1]")
  fi

  local keymap key
  for keymap in main emacs viins; do
    for key in "$up[@]"; do
      bindkey -M "$keymap" "$key" history-substring-search-up
    done
    for key in "$down[@]"; do
      bindkey -M "$keymap" "$key" history-substring-search-down
    done
  done
}

for antidote_source in \
  /opt/homebrew/opt/antidote/share/antidote/antidote.zsh \
  /usr/local/opt/antidote/share/antidote/antidote.zsh; do
  if [[ -r "$antidote_source" && -f "${ZDOTDIR:-$HOME}/.zsh_plugins.txt" ]]; then
    source "$antidote_source"
    antidote load "${ZDOTDIR:-$HOME}/.zsh_plugins.txt"
    break
  fi
done
unset antidote_source

# Directory jumping
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# Toolchain
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# Prompt
if [[ "$TERM_PROGRAM" != "Apple_Terminal" ]] && command -v oh-my-posh >/dev/null 2>&1; then
  oh_my_posh_config="${XDG_CONFIG_HOME:-$HOME/.config}/oh-my-posh/config.omp.json"
  if [[ -r "$oh_my_posh_config" ]]; then
    eval "$(oh-my-posh init zsh --config "$oh_my_posh_config")"
  else
    eval "$(oh-my-posh init zsh)"
  fi
  unset oh_my_posh_config
fi

# Aliases
alias ll='ls -lah'
alias la='ls -A'

# Parent-directory shortcuts (replaces Oh My Zsh's lib/directories.zsh).
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# Create a directory and enter it (replaces Oh My Zsh's `take`).
take() { mkdir -p -- "$1" && cd -- "$1"; }

alias gs='git status -sb'
alias gd='git diff'
alias gco='git checkout'
alias cdm='chezmoi'
