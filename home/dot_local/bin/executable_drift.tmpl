#!/bin/bash
# drift — where does this machine disagree with the repository? (§7)
# Report only: it never writes. Exit 0 when clean, 1 on any drift.

set -euo pipefail

# Drift is never measured Mac-to-Mac. Everything below compares this machine against the
# declarations carried in this file, which are the repository's (§7, ADR 0002).
#
# The Brewfile (§6.1) is inlined at render time, as the P4 scripts inline it — but for a
# different reason. There it is `run_onchange_`'s content hash; here it is §7's: the one
# command whose whole value is being run on a whim must not require the source tree to be
# on disk, let alone a `cd` into it.
# The work group (§6.1) is appended under the same `op` guard the P4 script inlines it
# behind, and this file is rendered by chezmoi too — so the check and the applying script
# evaluate one condition at one moment. That is why no special case for the group is
# written anywhere below: on a company Mac the five are declared and installed, on CI they
# are neither, and neither machine reports them under *Not in the repository*.
brewfile=$(
  cat <<'BREWFILE'
{{ include "../Brewfile" }}
{{ if lookPath "op" }}{{ include "../Brewfile.work" }}{{ end }}
BREWFILE
)

# The prefix cascade, included at render time (ADR 0005). This command is run from a login
# shell, which already has brew on PATH, and from the tail of a bootstrap, which does not.
{{ template "lib/homebrew.sh" . }}

# The managed defaults of §6.4, from the declaration P6 applies — the same table, read
# here rather than copied (ADR 0002). A second list of expected values beside the script
# that writes them would guarantee drift, which is an unusually poor property for a drift
# detector.
{{ template "lib/macos-defaults.sh" . }}

# The Dock's layout, from the declaration P6 reconciles against — the same comparison the
# reconcile performs, so the check and the application are one mechanism (ADR 0009).
{{ template "lib/dock.sh" . }}

missing=()
unmanaged=()
diverged=()
# What the machine was asked and did not answer. A sweep that cannot run is not a clean
# sweep, so it is said out loud rather than left to read as silence — under-reporting is
# the one failure a drift detector must not do quietly.
incomplete=()

# Declared, read from the entry shape §6.1 fixes — the same shape the P4 scripts and the
# CI reason-comment check read.
declared_taps=$(sed -n 's/^tap "\([^"]*\)".*/\1/p' <<<"$brewfile")
declared_formulae=$(sed -n 's/^brew "\([^"]*\)".*/\1/p' <<<"$brewfile")
declared_casks=$(sed -n 's/^cask "\([^"]*\)".*/\1/p' <<<"$brewfile")
declared_mas=$(sed -n 's/^mas "\([^"]*\)", id: \([0-9][0-9]*\).*/\2 \1/p' <<<"$brewfile")

# grep -x -F: a name matches a whole line or not at all, and never as a pattern.
#
# A here-string rather than a pipe, deliberately: `grep -q` exits at the first match and
# closes the pipe under it, and with `pipefail` the producer's SIGPIPE would then make a
# *successful* match report failure — intermittently, once the list outgrows the buffer.
listed() {
  grep -qxF -- "$1" <<<"$2"
}

# Every line of the first list that the second does not hold.
absent() {
  grep -vxF -f <(printf '%s\n' "$2") <<<"$1" || true
}

# Names what each line is, and drops the blank one an empty list yields.
label() {
  sed "/^\$/d; s/^/$1 /"
}

# App Store entries key on the id and report the name, so they are the one inventory
# `absent` cannot answer: a renamed app is the same entry, a reused name is not.
mas_absent() {
  local id name
  while read -r id name; do
    [ -n "$id" ] || continue
    listed "$id" "$2" || printf 'App Store %s (%s)\n' "$name" "$id"
  done <<<"$1"
}

# Asks the machine one question, into `$answer`, and says in `$answered` whether it came.
# An inventory nobody could read and an empty inventory look identical afterwards and mean
# opposite things — one is "nothing is installed", the other is "I do not know" — so an
# unanswered question puts a line in the report and takes its comparison out of the run
# entirely, rather than letting an empty answer report the whole inventory as missing.
answer=''
answered='no'
ask() {
  local unanswered=$1
  shift
  if answer=$("$@" 2>/dev/null); then
    answered='yes'
  else
    answer=''
    answered='no'
    incomplete+=("$unanswered")
  fi
}

homebrew='no'
installed_taps=''
installed_formulae=''
installed_casks=''
leaves=''
installed_mas=''
taps_known='no'
formulae_known='no'
casks_known='no'
leaves_known='no'
mas_known='no'

if ! command -v brew >/dev/null 2>&1; then
  incomplete+=('Homebrew is not installed, so the tap, formula, cask and application sweeps did not run.')
else
  homebrew='yes'
  ask 'brew tap did not answer, so no tap was checked.' brew tap
  installed_taps=$answer
  taps_known=$answered
  ask 'brew list --formula did not answer, so no formula was checked.' brew list --formula -1
  installed_formulae=$answer
  formulae_known=$answered
  ask 'brew list --cask did not answer, so no cask was checked.' brew list --cask -1
  installed_casks=$answer
  casks_known=$answered
  ask 'brew leaves did not answer, so nothing was swept for undeclared formulae.' brew leaves
  leaves=$answer
  leaves_known=$answered
fi

if ! command -v mas >/dev/null 2>&1; then
  incomplete+=('The mas CLI is not installed, so no App Store entry was checked.')
else
  ask 'mas list did not answer, so no App Store entry was checked.' mas list
  mas_known=$answered
  # `id  Name  (version)` — the id, and the name with its version and padding cut away.
  installed_mas=$(sed -n 's/^ *\([0-9][0-9]*\)  *\(.*[^ ]\)  *(.*)$/\1 \2/p' <<<"$answer")
fi
installed_mas_ids=$(awk '{print $1}' <<<"$installed_mas")
declared_mas_ids=$(awk '{print $1}' <<<"$declared_mas")

# Declared and absent. Formulae are compared against everything installed rather than
# against `brew leaves`: a declared formula pulled in as another's dependency is present,
# and presence is the whole question this section asks.
while IFS= read -r entry; do
  [ -n "$entry" ] || continue
  missing+=("$entry")
done < <(
  if [ "$taps_known" = 'yes' ]; then
    absent "$declared_taps" "$installed_taps" | label 'Tap'
  fi
  if [ "$formulae_known" = 'yes' ]; then
    absent "$declared_formulae" "$installed_formulae" | label 'Formula'
  fi
  if [ "$casks_known" = 'yes' ]; then
    absent "$declared_casks" "$installed_casks" | label 'Cask'
  fi
  if [ "$mas_known" = 'yes' ]; then
    mas_absent "$declared_mas" "$installed_mas_ids"
  fi
)

# Present and undeclared. Formulae are swept as leaves only: a dependency is not a
# decision, and listing dependencies would bury the entries that are (§7, ADR 0002).
#
# Taps are swept in one direction only, which is §7's sweep list rather than an oversight:
# Homebrew's own taps come and go with Homebrew, so a tap nobody declared is not a
# decision owed the way an application is.
while IFS= read -r entry; do
  [ -n "$entry" ] || continue
  unmanaged+=("$entry")
done < <(
  if [ "$leaves_known" = 'yes' ]; then
    absent "$leaves" "$declared_formulae" | label 'Formula'
  fi
  if [ "$casks_known" = 'yes' ]; then
    absent "$installed_casks" "$declared_casks" | label 'Cask'
  fi
  if [ "$mas_known" = 'yes' ]; then
    mas_absent "$installed_mas" "$declared_mas_ids"
  fi
)

# A dragged-in application is the one class of drift the Brewfile structurally cannot
# catch (§7), so /Applications is swept for bundles that came from neither source. Each
# bundle's provenance is derived from the bundle itself rather than from a list of
# exceptions this file would then have to maintain (rule 6).
if [ "$homebrew" = 'no' ] || [ "$casks_known" = 'no' ]; then
  : # Without the installed casks there is nothing to weigh a bundle against, and the
    # caveat above already says so.
elif ! command -v jq >/dev/null 2>&1; then
  incomplete+=('jq is not installed, so /Applications was not swept.')
else
  # The bundle names the installed casks claim, asked of Homebrew rather than guessed from
  # the cask's name — `microsoft-teams` and `telegram-desktop` alone would defeat guessing.
  #
  # A cask names its application in one of four places: an `app` artifact, the `target` a
  # relocated one is moved to, an `uninstall` path, or — for a cask that ships a `pkg` —
  # nowhere at all, because the installer package's receipt is what knows. Every `.app`
  # string anywhere in the artifacts covers the first three under one rule rather than
  # three; the receipts named there cover the fourth.
  cask_names=()
  while IFS= read -r cask; do
    [ -n "$cask" ] || continue
    cask_names+=("$cask")
  done <<<"$installed_casks"

  cask_json=''
  if [ ${#cask_names[@]} -gt 0 ]; then
    ask 'brew info --cask did not answer, so /Applications was not swept.' \
      brew info --cask --json=v2 "${cask_names[@]}"
    cask_json=$answer
  fi

  # Sweeping on an empty set of claims would report every third-party application at once,
  # which is worse than not sweeping: a report that cries wolf is one nobody finishes.
  if [ ${#cask_names[@]} -gt 0 ] && [ -z "$cask_json" ]; then
    : # `ask` has already said the sweep did not run.
  else
    cask_apps=''
    cask_pkgids=''
    if [ -n "$cask_json" ]; then
      cask_apps=$(jq -r '[.casks[].artifacts | .. | strings] | .[] | select(endswith(".app"))' <<<"$cask_json" | sed 's|.*/||')
      cask_pkgids=$(jq -r '[.casks[].artifacts | .. | objects | select(has("pkgutil")) | .pkgutil] | flatten | .[]' <<<"$cask_json")
    fi

    while IFS= read -r pkgid; do
      [ -n "$pkgid" ] || continue
      # Paths in a receipt are relative to the package's install location, so a bundle
      # installed into /Applications is a top-level entry. A cask may name a package this
      # machine never received — an architecture's sibling, an optional component — and an
      # absent receipt is silence, not an error.
      from_receipt=$(pkgutil --files "$pkgid" 2>/dev/null | sed -n '/^[^/]*\.app$/p') || from_receipt=''
      cask_apps+=$'\n'"$from_receipt"
    done <<<"$cask_pkgids"

    for bundle in /Applications/*.app; do
      [ -d "$bundle" ] || continue
      name=$(basename "$bundle")

      # An App Store copy carries a receipt inside the bundle, whoever installed it.
      if [ -e "$bundle/Contents/_MASReceipt/receipt" ]; then
        continue
      fi

      listed "$name" "$cask_apps" && continue

      # macOS's own applications are signed by Apple's internal authority, which no
      # Developer ID application carries. Checked last, so it runs only for the handful of
      # bundles neither inventory already claimed. The signature is read into a variable
      # first, for the reason `listed` states: `grep -q` closing the pipe early under
      # `pipefail` turns a match into a failure.
      signature=$(codesign -dvv "$bundle" 2>&1) || signature=''
      if listed 'Authority=macOS Software Signing' "$signature"; then
        continue
      fi

      unmanaged+=("Application $name")
    done
  fi
fi

# Managed files, which `chezmoi status` covers completely (ADR 0002) — the one section
# this command delegates outright rather than derives.
#
# Scripts are excluded: a `run_after_` script is pending by design on every run (§4), so
# including them would report the bootstrap's own epilogue as drift, permanently.
if ! command -v chezmoi >/dev/null 2>&1; then
  incomplete+=('chezmoi is not installed, so no managed file was checked.')
else
  ask 'chezmoi status did not answer, so no managed file was checked.' \
    chezmoi status --exclude=scripts
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    diverged+=("${line:0:2}  ${line:3}")
  done <<<"$answer"
fi

# Managed defaults, which chezmoi cannot see at all: it tracks the applying script's
# content hash, not its effect, so a key changed in System Settings leaves `chezmoi
# status` clean (ADR 0002). Only the keys the repository declares are read — never
# `defaults read` over a whole domain (§7). A Mac holds thousands of defaults and about
# two dozen are decisions; enumerating the declaration bounds the comparison set to a
# number that was chosen rather than discovered.
while IFS=$'\t' read -r domain key type value scope; do
  [ -n "$domain" ] || continue

  expected=$(managed_default_expected "$type" "$value")
  current=$(managed_default_current "$scope" "$domain" "$key")
  if [ "$current" = "$expected" ]; then
    continue
  fi

  # A system setting you do not have is a *wrong* setting rather than an absence, because
  # macOS always supplies its own value — so an unset key is diverged, not missing (§6.4).
  diverged+=("Default $(managed_default_label "$scope" "$domain") $key: expected $expected, is ${current:-unset}")
done <<<"$managed_defaults"

# The Dock's layout, which is neither a managed file nor a flat default and so falls
# through both checks above. One line, because the layout matches or it does not, followed
# by the two sequences — the same information a per-tile diff carries, for a fraction of
# the shell (ADR 0009). It is compared against the **rendered** declaration, so an
# application that never installed is reported once, truthfully, by the Brewfile sweep,
# and not a second time here as layout drift. The stated consequence: a Dock short a tile
# because its cask failed reads clean in this section and red in that one.
dock_expected=$(dock_expected_sequence)
if ! dock_current=$(dock_current_sequence); then
  incomplete+=('The Dock preferences could not be read, so the layout was not checked.')
elif [ "$dock_current" != "$dock_expected" ]; then
  diverged+=('Dock layout: the tile sequence does not match the declaration')
  diverged+=("  expected: $(dock_sequence_label "$dock_expected")")
  diverged+=("  actual:   $(dock_sequence_label "$dock_current")")
fi

{{ if lookPath "op" }}
# The work identity (§6.5), which is the one thing in this repository that can fail
# quietly: a render skipped for want of 1Password leaves the files personal-only, valid
# and silent, and the first sign of it is a work commit signed by the wrong key. The check
# is rendered under the same `op` guard as the templates it asks about, so it asks only on
# a machine those templates were supposed to write to — which is what makes it catch the
# case that matters: an apply whose environment had no `op`, read back later from a shell
# that does. An unguarded check would instead report CI, where nothing was skipped.
#
# Two files answer for all five surfaces of the identity. One 1Password read feeds them
# all, so they render together or not at all; asking each in turn would be five questions
# with one answer.
for rendered in "$HOME/.ssh/id_work.pub" "$HOME/.config/git/config-work"; do
  if [ ! -s "$rendered" ]; then
    diverged+=("Work identity: $rendered did not render — re-apply with 1Password unlocked")
  fi
done
{{ end }}
# Two things are deliberately not swept, and their absence is written down so it is not
# read as an oversight and repaired (§7): `mise` runtimes, which `mise ls` already diffs
# against its own configuration, and `chezmoi unmanaged` over $HOME, which reports every
# file the repository has never claimed and so reports nothing.

section() {
  local title=$1
  shift
  printf '\n%s\n\n' "$title"
  printf '  %s\n' "$@"
}

# Empty sections are omitted, which is also why the bootstrap's epilogue needs no brief
# mode: on a fresh machine nothing is unmanaged, so that section simply is not printed.
if [ ${#missing[@]} -gt 0 ]; then
  section 'Missing on the machine — run the bootstrap again' "${missing[@]}"
fi

if [ ${#unmanaged[@]} -gt 0 ]; then
  section 'Not in the repository — a decision owed to the repository' "${unmanaged[@]}"
fi

if [ ${#diverged[@]} -gt 0 ]; then
  section 'Diverged value — re-apply, or adopt' "${diverged[@]}"
fi

# Not a fourth section: the three are findings, this is the report's own reach. It exits 1
# on its own, because a report that did not look cannot say the machine is clean.
if [ ${#incomplete[@]} -gt 0 ]; then
  section 'This report is incomplete' "${incomplete[@]}"
fi

if [ $((${#missing[@]} + ${#unmanaged[@]} + ${#diverged[@]} + ${#incomplete[@]})) -gt 0 ]; then
  printf '\n'
  exit 1
fi

printf 'No drift: this machine matches the repository.\n'
