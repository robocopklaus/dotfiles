[core]
	editor = code --wait
	excludesfile = ~/.gitignore

[alias]
	l = log --pretty=oneline -n 20 --graph --abbrev-commit
	s = status -s

[diff]
	renames = copies
	algorithm = histogram
	tool = code

[fetch]
	prune = true

[rebase]
	autoStash = true

[rerere]
	enabled = true

[difftool "code"]
	cmd = code --wait --diff "$LOCAL" "$REMOTE"

[merge]
	tool = code

[mergetool "code"]
	cmd = code --wait "$MERGED"

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true

[user]
	name = Fabian Pahl
	email = 7754932+robocopklaus@users.noreply.github.com
	signingkey = ~/.ssh/id_personal.pub

[gpg]
	format = ssh

[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = ~/.config/git/allowed_signers

[commit]
	gpgSign = true

[tag]
	gpgSign = true
{{ if lookPath "op" }}
# The work identity (§6.5), switched on by the remote a repository points at rather than
# by the directory it sits in. The host pattern is part of the identity and leaks the same
# fact the rest of it does, so this condition is rendered from the same 1Password item as
# the file it includes — and on a machine without `op` neither is written. Only [user] is
# overridden there; everything above is inherited. Requires git >= 2.36 (hasconfig).
[includeIf "hasconfig:remote.*.url:*@{{ (fromJson (includeTemplate "lib/work-identity.json" .)).host }}:**/**"]
	path = ~/.config/git/config-work
{{- end }}
