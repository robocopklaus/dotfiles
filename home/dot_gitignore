# A global ignore holds what this machine produces in every repository it
# touches. Build output, dependencies and coverage belong to a project and are
# declared by that project, where a collaborator can see the rule too.

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Editor swap and backup files
*.swp
*.swo
*~

# Kept against the rule above: a project that forgets this one leaks
# credentials, and the cost of the exception is a file nobody commits anyway.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
