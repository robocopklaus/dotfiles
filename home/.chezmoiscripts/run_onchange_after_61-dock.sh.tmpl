#!/bin/bash
# Phase: P6 — system configuration: the Dock's layout, reconciled against the declaration
# Requires: P4 (the applications the tiles point at, and dockutil), a non-root user

set -euo pipefail

# `dockutil` is a formula, so it is on PATH only through Homebrew's (ADR 0005).
{{ template "lib/homebrew.sh" . }}

# The declaration and everything a consumer of it needs, included at render time (ADR
# 0005). It is *in* this rendered script, so editing `dock.toml` re-triggers this phase by
# construction — the same binding 40 gets from inlining the Brewfile.
{{ template "lib/dock.sh" . }}

# The marker 60 leaves when a key in `com.apple.dock` changed, so that the two managers of
# that domain cost one restart rather than two.
{{ template "lib/dock-restart.sh" . }}

{{ template "lib/ui.sh" . }}

ui_header 'P6  system configuration · Dock'

# Reconciled, not rebuilt (ADR 0009): read the current tile sequence, compare it to the
# expected one, and go near `dockutil` only on mismatch. On a converged machine this
# prints only its header, changes nothing and restarts nothing — which is what makes a
# routine apply something you do not learn to avoid.
#
# The expected sequence is the declaration rendered against this machine: an application
# that never installed drops out, and its category keeps its spacer only if something
# else in it survived.
expected=$(dock_expected_sequence)
current=$(dock_current_sequence)

# Clear and re-add, which is the destructive rebuild the prior setup ran on *every*
# apply. Behind the comparison below it is a different thing: it fires only when the Dock
# has genuinely diverged, so the plist backup and its five-deep prune are gone with the
# reason they existed (ADR 0009).
#
# Each failure is returned by hand, because this runs as a step, where `set -e` does not
# reach.
rebuild() {
  local kind path view sort display
  dockutil --remove all --no-restart >/dev/null || return

  # Each call reads from /dev/null, not from the here-string the loop is walking: a child
  # that touched stdin would eat the rest of the sequence and leave a Dock that is half
  # the declaration, silently and only sometimes.
  while IFS=$'\t' read -r kind path view sort display; do
    case $kind in
      app)
        dockutil --add "$path" --no-restart >/dev/null </dev/null || return
        ;;
      spacer)
        dockutil --add '' --type small-spacer --section apps --no-restart >/dev/null </dev/null || return
        ;;
      folder)
        dockutil --add "$path" --view "$view" --sort "$sort" --display "$display" \
          --no-restart >/dev/null </dev/null || return
        ;;
    esac
  done <<<"$expected"
}

rebuilt='no'
if [ "$current" != "$expected" ]; then
  ui_step 'Dock layout' rebuild
  ui_note "was:  $(dock_sequence_label "$current")"
  ui_note "now:  $(dock_sequence_label "$expected")"
  rebuilt='yes'
fi

# The one restart, at the end of P6 and after the layout is written, covering both
# managers of the domain: this step and the defaults table before it. Every
# `dockutil` call above passes `--no-restart` for exactly this reason.
if [ "$rebuilt" = 'yes' ] || [ -e "$dock_restart_request" ]; then
  rm -f "$dock_restart_request"
  # macOS brings it straight back, and it is not worth failing the phase over.
  killall Dock >/dev/null 2>&1 || true
  ui_ok 'Dock restarted'
fi
