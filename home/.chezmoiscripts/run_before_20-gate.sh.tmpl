#!/bin/bash
# Phase: P2 — gate
# Requires: P1 (chezmoi binary and source clone)

set -euo pipefail

# Verifies every P0 precondition, and acquires the two of them it can: the run's
# root privilege and the trust chain — Homebrew and the 1Password casks P3's templates
# read through. Failures are reported together, each beside the remedy that fixes it.
# Running before any file is applied means a refusal leaves $HOME completely untouched.
#
# Three P0 items are not verifiable at all — the GitHub key registration, the App Store
# sign-in and the Apple Account sign-in — so they are not here. An unverifiable item is a
# line in the closing report, never a gate check and never a "have you signed in? [y/N]"
# prompt.
#
# The Apple Account joined them by evidence, not by argument. The gate read the
# `MobileMeAccounts` domain, which a freshly set up machine does not have even when it is
# signed in: that domain is written when iCloud first stores something in it, not at
# sign-in. So it refused a correctly prepared machine, and refused it for nothing — P4's
# `mas` phase is tolerant of a missing account on its own, and the closing report already
# asks for the sign-in the phase needs.

refused=()
reported=()

# Each check states its own remedy at the call site. A remedy list maintained apart
# from the checks it serves would drift, and the copy that drifts waves you through.
refuse() {
  refused+=("$1"$'\n'"    $2")
}

# Under CI the 1Password items degrade from refusing to reporting.
# The signal is `CI`, set by the runner and never written by this repository; deriving
# it from op's absence would wave through the fresh Mac the gate exists for.
refuse_unless_ci() {
  if [ -n "${CI:-}" ]; then
    reported+=("$1"$'\n'"    $2")
  else
    refuse "$1" "$2"
  fi
}

print_items() {
  local item
  for item in "$@"; do
    printf '  ✗ %s\n' "$item"
  done
}

# Printing and exiting is a function because the gate stops in two places, not one: the
# foundation below is what the acquisition itself stands on, so it cannot be collected
# and reported alongside the items that only become checkable once it holds.
settle() {
  if [ ${#reported[@]} -gt 0 ]; then
    printf '\nPreflight gate: reported, not refused (CI):\n\n'
    print_items "${reported[@]}"
  fi

  if [ ${#refused[@]} -gt 0 ]; then
    printf '\nPreflight gate: %d precondition(s) not met. Nothing has been written to %s.\n\n' \
      "${#refused[@]}" "$HOME"
    print_items "${refused[@]}"
    printf '\nFix the items above, then run the command again.\n\n'
    exit 1
  fi
}

# The foundation: everything the acquisition and every later phase rests on. These are
# still reported in one pass with each other — it is only the trust chain that had to
# move behind them, because installing it is what needs them.

# Administrator rights, first and once: P4 needs root, and this is the run's single
# interactive moment. Acquiring the privilege here means no later phase discovers
# its absence halfway through a bundle.
printf 'Preflight gate: checking administrator rights — macOS may ask for your password.\n'
if ! sudo -v; then
  refuse "Administrator rights are not available (sudo -v failed)." \
    "Run the bootstrap from an account with administrator rights."
fi

# macOS 26 or newer on Apple Silicon
architecture=$(uname -m)
if [ "$architecture" != "arm64" ]; then
  refuse "This is not an Apple Silicon Mac (uname -m reports $architecture)." \
    "Rebuild on an Apple Silicon Mac — this repository manages no Intel machine."
fi

macos_version=$(sw_vers -productVersion)
if [ "${macos_version%%.*}" -lt 26 ]; then
  refuse "macOS $macos_version is older than the macOS 26 this repository targets." \
    "Update first: System Settings → General → Software Update."
fi

# Network
if ! curl -fsS --max-time 10 -o /dev/null https://github.com; then
  refuse "github.com is not reachable." \
    "Join a network that reaches github.com, then re-run."
fi

# Xcode Command Line Tools. Checked, never installed and never waited on: the
# prior setup's 3600s poll for them is deliberately not carried over.
if ! xcode-select --print-path >/dev/null 2>&1; then
  refuse "The Xcode Command Line Tools are not installed." \
    "Run: xcode-select --install — wait for it to finish, then re-run."
fi

settle

# The trust chain: Homebrew, and through it the two 1Password casks. Acquired here rather
# than asked of you, because a command you would have typed by hand is a command this run
# can type for you — and because P4, which installs everything else, comes after the P3
# that already needs `op`.
#
# Nothing below can make the run unattended: signing in to 1Password and turning on its
# two developer toggles are GUI work, so a fresh machine still stops here once. What this
# removes is the part that was never GUI work, and every check below is unchanged — an
# acquisition that fails refuses exactly as it did when you were the one installing.
#
# Cask installs download hundreds of megabytes before they ask for root, which outlives
# the timestamp `sudo -v` just set, so the privilege is kept warm across the acquisition.
{{ template "lib/keepalive.sh" . }}

# A no-op wherever Homebrew already is, which includes every CI runner and every
# re-run after the first.
{{ template "lib/homebrew-install.sh" . }}

# The casks themselves, skipped under CI: the runner wants neither, and its 1Password
# items report rather than refuse anyway.
#
# Tolerant by construction, and `|| true` is the whole handling: the checks below already
# state what is missing and how to fix it, so a second reaction here would be the second
# list this repository spends its rules preventing.
if [ -z "${CI:-}" ]; then
  for cask in 1password 1password-cli; do
    if brew list --cask "$cask" >/dev/null 2>&1; then
      continue
    fi
    printf 'Preflight gate: installing %s.\n' "$cask"
    brew install --cask --adopt "$cask" || true
  done
fi

# 1Password and its CLI. Still checked, and the remedies still name the commands: the
# acquisition above is what normally satisfies them, not a guarantee that it did.
if [ ! -d "/Applications/1Password.app" ]; then
  refuse_unless_ci "1Password is not installed, and the gate could not install it." \
    "Run: brew install --cask 1password — then open it and sign in."
fi

if ! command -v op >/dev/null 2>&1; then
  refuse_unless_ci "The 1Password CLI (op) is not on PATH, and the gate could not install it." \
    "Run: brew install --cask 1password-cli — then turn on 1Password → Settings → Developer → Integrate with 1Password CLI."
fi

# The paths inside 1Password's group container, included at render time so that every
# caller spells the container once. Both checks below read from them.
{{ template "lib/onepassword-paths.sh" . }}

# App data access, which is the other way the handover fails. The CLI integration can be
# on and `op` still hold no account, because `op` reads the account out of the app's own
# settings file and macOS can withhold that file from the terminal the run is typed into.
# `op --debug` says so plainly — `Skipped loading desktop app settings file … operation
# not permitted` — and then reports no account at all.
#
# It is checked separately rather than folded into the remedy below because the two
# machines want opposite things done to them, and the check below cannot tell them apart:
# it would name the toggle on a machine whose toggle is already on.
#
# Asked of the file rather than of `op --debug`, whose wording is 1Password's to change.
# A check that reads an error message passes silently the day the message is reworded,
# and a gate that passes silently is worse than no gate.
#
# Unreadable, not absent. The gate installs the app (ADR 0012), and an app that has never
# been opened has written no settings yet — that machine falls through to the check below,
# whose remedy is the one it needs. `-e` answers the question macOS leaves answerable:
# the file can be stat'd while opening it is refused.
if [ -e "$app_settings" ] && ! head -c 1 "$app_settings" >/dev/null 2>&1; then
  refuse_unless_ci "1Password's app data cannot be read, so op is handed no account." \
    "Re-run the command you started with, with OP_BIOMETRIC_UNLOCK_ENABLED=true in front of it — that makes op ask the running app instead of reading the file. Nothing in the run can set it for you: chezmoi reads the 1Password item itself, so the variable has to be in the environment the command is typed into. macOS does not offer this permission under Privacy & Security; the terminal is not listed there at all."
fi

# The CLI integration, asked of `op account list` — which reads local metadata, returns
# at once and unlocks nothing. Without the integration turned on, `op` knows no account at
# all: `~/.config/op/config` carries `"accounts": null` even on a working machine, because
# the account is handed over by the app.
#
# Not `op whoami`, which is the tempting one and asks a different question: whether a
# session is open. The run does not need one here — it is created at first use, when P3
# renders the work identity and the app authenticates — so a machine with the integration
# on and the vault simply not unlocked yet answers `account is not signed in`. Gating on
# that refuses a correct machine.
#
# This is checked rather than left to P3 because of what P3 does without it. chezmoi calls
# `op signin`, and `op` with no account does not fail — it *asks*, for a sign-in address,
# an email, a secret key and a password, in the middle of a run that has exactly
# one interactive moment. Then it times out. A precondition whose absence turns the run
# into a credential prompt belongs in front of the run, not inside it.
#
# Read from /dev/null, because the command being asked about is the one that prompts. `op`
# with no account offers to add one interactively — that is the observed failure this
# check exists to prevent — and a check that can itself sit waiting for an answer is the
# defect wearing the fix's clothes. With stdin at EOF the offer cannot be taken, `op`
# gives up, and the empty output is the answer. The guidance it prints goes to stderr,
# which is discarded for the same reason: what is tested is whether an account came back.
#
# Emptiness, and nothing else. Two tidier-looking tests are both wrong, measured on a
# machine with no account: the exit status is **0**, and `--format=json` prints `[]`,
# which is not empty. Either one turns this check into a check that always passes.
if command -v op >/dev/null 2>&1 && [ -z "$(op account list </dev/null 2>/dev/null)" ]; then
  refuse_unless_ci "The 1Password CLI has no account: the app is handing it none." \
    "Quit 1Password fully (⌘Q), reopen it, unlock it, and check Settings → Developer → Integrate with 1Password CLI — that switch, not the SSH agent one beside it. The accounts come from the running app, so it is fixed when 'op account list' prints one."
fi

# The 1Password SSH agent, which P3's ~/.ssh/config is written against and P7's remote
# rewrite waits for. This is the one the acquisition can never satisfy: it is a toggle
# behind an unlock.
if [ ! -S "$agent_socket" ]; then
  refuse_unless_ci "The 1Password SSH agent socket is missing ($agent_socket)." \
    "Unlock 1Password, then turn on Settings → Developer → Use the SSH agent."
fi

settle
