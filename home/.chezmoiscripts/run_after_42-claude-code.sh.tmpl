#!/bin/bash
# Phase: Packages — the Claude Code CLI, from its native installer
# Requires: the Files phase, network

set -euo pipefail

# Separate from 40 because the precondition is: the CLI has no Homebrew formula, so it
# comes from its own installer and wants network rather than Homebrew. A precondition of
# its own is a script of its own. The `claude` cask in the Brewfile is the desktop
# application — a different artifact from a different source, and not this script's
# business.
#
# No keepalive and no `sudo`, unlike its two siblings: the installer puts everything under
# `$HOME` and refuses outright when invoked through `sudo`, so this is the one script
# in the Packages phase that stays unprivileged.
#
#
# `run_after_`, not `run_onchange_after_`: this script inlines no inventory, so its
# rendered content never changes and content-hash skipping would make it a `run_once_` in
# disguise, which the one-command contract bans. The script conventions have the
# reasoning; the guard below is what makes re-deriving on every run cheap.

# The managed `.zshrc` already puts `~/.local/bin` first on PATH, but this script
# runs in chezmoi's environment rather than a login shell. Seeding it here is what lets the
# guard see a CLI that is already installed.
export PATH="$HOME/.local/bin:$PATH"

# Present is converged. The CLI updates itself, so there is no version for the bootstrap
# to chase: this phase's job is that it exists, and a re-run that downloaded it again
# would be work performed to arrive where the machine already is.
if command -v claude >/dev/null 2>&1; then
  exit 0
fi

{{ template "lib/ui.sh" . }}

ui_header 'Packages · Claude Code CLI'

# Fetched into a variable first, for the reason 40 states: piped straight into bash a
# failed download is invisible, because the substitution yields an empty script that
# exits 0.
#
# Tolerant end to end, because nothing later in the run depends on the CLI — the Runtimes,
# System settings and Integrations phases take their preconditions from 40 and 41. A failure is reported and the run carries
# on to the phases that do block.
install_cli() {
  local installer
  installer=$(curl -fsSL https://claude.ai/install.sh) && /bin/bash -c "$installer"
}
if ! ui_step 'Claude Code CLI' install_cli; then
  ui_note 'Re-run the bootstrap to retry; the closing report re-derives what is missing.'
fi
