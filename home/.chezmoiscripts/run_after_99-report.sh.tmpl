#!/bin/bash
# Phase: 9x — the epilogue: the closing report
# Requires: nothing — a missing `drift` shortens the report; it never fails the run

# The epilogue draws only headers and notes, so the rest of `lib/ui.sh` is never called
# here and the linter would report every function in it as unused and every line as
# unreachable.
# shellcheck disable=SC2317,SC2329

# No `set -e`, alone among the scripts here: chezmoi aborts on a non-zero script, and
# `drift` exits 1 on any finding — a true report rather than a failed run. The epilogue
# never fails the run; the last line of this file is what enforces it.
set -uo pipefail

# `run_after_` at a `9x` slot outside the phase range, for a reason of its own: this
# script re-derives on every run, so content-hash skipping would stop a converged machine
# being told what it is still missing.

{{ template "lib/ui.sh" . }}

ui_header 'The closing report'

# Dynamic — what is missing *right now*, re-checked rather than replayed. There is no
# scratch file for the phases to append to: that is the recorded intermediate state the
# convergence invariant bans, and it would go stale on the second run and then lie.
#
# The same invocation a human types at a desk, with no extra flag: `drift` omits empty
# sections, so nothing a brief mode would have to suppress is printed anyway.
#
# The managed `.zshrc` puts `~/.local/bin` first on PATH, but this script runs in
# chezmoi's environment rather than a login shell, so that declaration has not been read
# here. Seeding it is what lets the guard below see a `drift` that P3 did write.
export PATH="$HOME/.local/bin:$PATH"

printf '\n'
if command -v drift >/dev/null 2>&1; then
  # Its exit status is discarded rather than propagated: drift's 1 means "this machine
  # disagrees with the repository", which is the message, not a malfunction.
  drift || true
else
  printf 'drift is not on PATH, so nothing could be re-checked. Re-run the bootstrap.\n'
fi

# The remainder — what no script can perform and no script can verify.
#
# Everything above is derived from the machine. Everything below cannot be: it is GUI work
# behind accounts, and a self-attested "have you signed in? [y/N]" would be a prompt
# wearing a gate's clothes — it blocks the run while verifying nothing. A manual step
# is either verifiable, in which case the gate refuses on it, or it is not, in which case
# it is a line here. There is no third category (ADR 0015).
#
# It says what to do and leaves the why where it is recorded: the gate's comments for the
# Apple Account and the App Store, ADR 0006 for what restores itself and for the
# credential files, ADR 0010 for agent tooling.
#
# Hand-written rather than derived from a declaration: nothing the run reads declares
# these, because the repository does nothing about them. This is the one list of them;
# ADR 0006 holds the rule that admits an entry, not a copy.
#
# No glyph marks an item: nothing can tick it, and ✓ and ✗ mean the run checked. Columns
# are padded by hand to fit 80, since `lib/ui.sh` does no width detection (ADR 0017).
ui_header 'The rest is yours — no script can do or check any of it'

printf '\nSign in\n'
# Authentication and signature verification are separate registrations of the same key,
# and the second one is the one that is silently forgotten.
printf '  %-16s%s\n' 'GitHub' 'register the key under both SSH keys and SSH signing keys'
printf '  %-16s%s\n' 'Apple Account' 'System Settings'
printf '  %-16s%s\n' 'App Store' 'the App Store app'
ui_note 'Re-run the bootstrap if an App Store app is missing above.'

printf '\nRestores itself once you sign in\n'
printf '  %s\n' \
  '1Password, Chrome, VS Code, Slack, ChatGPT, Mimestream, Clockify,' \
  'WhatsApp, GCal, Docker Desktop' \
  'Agent skills and plugins, via the claude.ai account'
ui_note 'Allow 15 minutes before an empty plugin list means anything.'

printf '\nAllow on first launch\n'
# Neither does anything without Accessibility, and InstantSpaceSwitcher is unsigned, so
# Gatekeeper holds its first launch until it is let through. The privacy database
# behind both is unreadable without Full Disk Access, so the run cannot check either.
printf '  %-22s%s\n' 'InstantSpaceSwitcher' 'Privacy & Security → Open Anyway, then Accessibility'
printf '  %-22s%s\n' 'Amethyst' 'Accessibility'

printf '\nFrom 1Password, when the tool first asks\n'
# The tilde is text for a human, not a path for the shell to expand.
# shellcheck disable=SC2088
printf '  %-16s%s\n' '~/.cloudflare' 'cli4'
printf '\n'

# The last line, and the reason there is no `set -e` above: whatever was reported, the run
# ends having succeeded. The report is the deliverable; failing on it would make the one
# script that tells the truth about the machine the one that hides the rest of the run.
exit 0
