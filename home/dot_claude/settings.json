{
  "permissions": {
    "defaultMode": "auto"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "grep -qiE 'co-authored-by:[[:space:]]*claude|generated with \\[?claude code' && { echo 'Attribution is off in ~/.claude/settings.json: drop the Claude trailer or footer.' >&2; exit 2; }; exit 0"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "mise exec -- pnpm dlx ccstatusline@latest",
    "padding": 0,
    "refreshInterval": 10
  },
  "theme": "auto",
  "tui": "fullscreen",
  "effortLevel": "medium",
  "autoMemoryEnabled": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true
}