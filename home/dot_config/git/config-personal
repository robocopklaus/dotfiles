# The personal identity (ADR 0011, ADR 0018). Included by ~/.gitconfig for every repository
# on github.com, in either spelling — this person's own, the company's organisations and
# any client's — because all of them are reached through this one account.
#
# Cleartext, because it is already public on GitHub. It carries the address and the key,
# and nothing else: `user.name` and the signing setup are shared by both identities and
# live in ~/.gitconfig.
#
# The address is the account's no-reply one. Its primary address is private on the
# account, and the no-reply one is what GitHub expects on a pushed commit (ADR 0018).
[user]
	email = 7754932+robocopklaus@users.noreply.github.com
	signingkey = ~/.ssh/id_personal.pub
